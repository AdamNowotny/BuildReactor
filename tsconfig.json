{
    "include": ["src/**/*", "eslint.config.mjs"],
    "exclude": ["node_modules", "**/*.spec.ts"],
    "compilerOptions": {
        "allowJs": true,
        "esModuleInterop": true,
        "jsx": "react",
        "lib": ["ESNext", "DOM"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noImplicitAny": false,
        "outDir": "./dist",
        "paths": {
            "common/*": ["./src/common/*"],
            "dashboard/*": ["./src/dashboard/*"],
            "options/*": ["./src/options/*"],
            "service-worker/*": ["./src/service-worker/*"],
            "services/*": ["./src/services/*"]
        },
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "strict": true,
        "strictNullChecks": true,
        "target": "ESNext",
        "types": ["unplugin-icons/types/react", "chrome", "vite/client"]
    }
}
